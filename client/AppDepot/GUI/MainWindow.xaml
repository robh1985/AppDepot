<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppDepot" Width="1200" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA"
        FontFamily="Segoe UI" FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentDark" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Ink" Color="#111827"/>
    <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
    <SolidColorBrush x:Key="Line" Color="#E5E7EB"/>

    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#C7D2FE"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="10,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="14,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#24324F"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2E3F66"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TabButton" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Foreground" Value="#374151"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="16" Padding="16,6" Background="White" BorderBrush="#D1D5DB" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#D1D5DB"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#B91C1C"/>
      <Setter Property="BorderBrush" Value="#FCA5A5"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,4,12,4"/>
    </Style>
    <Style x:Key="FieldValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="AppItem" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="White" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,10">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ============ Sidebar ============ -->
    <Border Background="#1A2440">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Margin="22,24,16,24">
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Accent}">
              <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="AppDepot" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Application repository" Foreground="#94A3B8" FontSize="11"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
          <RadioButton x:Name="NavCatalog" Style="{StaticResource NavButton}" Tag="&#xE719;" GroupName="Nav" IsChecked="True" Content="Catalog"/>
          <RadioButton x:Name="NavInstalled" Style="{StaticResource NavButton}" Tag="&#xE7B8;" GroupName="Nav" Content="Installed"/>
          <RadioButton x:Name="NavUpdates" Style="{StaticResource NavButton}" Tag="&#xE895;" GroupName="Nav">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Updates"/>
              <Border x:Name="UpdateBadge" Background="#F59E0B" CornerRadius="9" Padding="7,0" Margin="8,0,0,0" Visibility="Collapsed">
                <TextBlock x:Name="UpdateBadgeText" Text="0" Foreground="White" FontSize="11" FontWeight="Bold"/>
              </Border>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavAdd" Style="{StaticResource NavButton}" Tag="&#xE710;" GroupName="Nav" Content="Add apps"/>
          <RadioButton x:Name="NavActivity" Style="{StaticResource NavButton}" Tag="&#xE81C;" GroupName="Nav" Content="Activity"/>
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" GroupName="Nav" Content="Settings"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="16" Padding="12" CornerRadius="8" Background="#222E4F">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ConnDot" Width="9" Height="9" Fill="#9CA3AF" VerticalAlignment="Center"/>
              <TextBlock x:Name="ConnText" Text="Connecting..." Foreground="#E2E8F0" Margin="8,0,0,0" FontSize="12"/>
            </StackPanel>
            <TextBlock x:Name="ServerText" Text="" Foreground="#94A3B8" FontSize="11" Margin="17,4,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- ============ Main area ============ -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid Margin="28,22,28,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Catalog" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
          <TextBlock x:Name="PageSubtitle" Text="Applications available in the repository" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="SearchBox" Background="White" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1" Width="280" Height="36">
            <Grid>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="SearchHint" Text="Search applications" Foreground="#9CA3AF" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBox x:Name="SearchText" Margin="30,0,8,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
            </Grid>
          </Border>
          <Button x:Name="UpdateAllButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Update all"/>
            </StackPanel>
          </Button>
          <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" ToolTip="Refresh (F5)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Refresh"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Elevation banner -->
      <Border x:Name="ElevationBanner" Grid.Row="1" Margin="28,0,28,12" Padding="14,10" CornerRadius="8"
              Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="ElevateButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,4" Content="Restart as administrator"/>
          <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock VerticalAlignment="Center" Foreground="#92400E" TextWrapping="Wrap"
                     Text="AppDepot is not running as administrator. Applications that install for all users will fail."/>
        </DockPanel>
      </Border>

      <!-- Apps view (Catalog / Installed / Updates) -->
      <Grid x:Name="AppsView" Grid.Row="2" Margin="28,0,28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid>
          <ListView x:Name="AppList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource AppItem}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="40" Height="40" CornerRadius="9" Background="{Binding Color}">
                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#111827"/>
                    <TextBlock Foreground="#6B7280" FontSize="12" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Publisher, Mode=OneWay}"/>
                      <Run Text="  &#183;  "/>
                      <Run Text="{Binding Category, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Right" Foreground="#374151" FontSize="12"/>
                    <Border CornerRadius="9" Padding="8,1" Margin="0,4,0,0" HorizontalAlignment="Right" Background="{Binding StatusBackground}">
                      <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusForeground}"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyText" Text="Nothing to show" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <!-- Details pane -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
          <Grid>
            <TextBlock x:Name="NoSelection" Text="Select an application to see its details" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ScrollViewer x:Name="DetailsPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel Margin="22">
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="DetailBadge" Width="56" Height="56" CornerRadius="12" Background="#2563EB">
                    <TextBlock x:Name="DetailInitials" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="250">
                    <TextBlock x:Name="DetailName" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailPublisher" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </StackPanel>

                <Border x:Name="DetailStatus" CornerRadius="6" Padding="10,6" Margin="0,16,0,0">
                  <TextBlock x:Name="DetailStatusText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Foreground="#374151" Margin="0,14,0,0" LineHeight="19"/>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Latest version"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" x:Name="DetailLatest" FontWeight="SemiBold"/>
                  <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Installed version"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" x:Name="DetailInstalled"/>
                  <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Category"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" x:Name="DetailCategory"/>
                  <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Installer"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" x:Name="DetailInstaller"/>
                  <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Download size"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}" x:Name="DetailSize"/>
                  <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Added to repository"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldValue}" x:Name="DetailDownloaded"/>
                  <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="License"/>
                  <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldValue}" x:Name="DetailLicense"/>
                  <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="Application id"/>
                  <TextBox Grid.Row="7" Grid.Column="1" x:Name="DetailId" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="0,4"/>
                  <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="Website"/>
                  <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldValue}">
                    <Hyperlink x:Name="DetailHomepage"><Run x:Name="DetailHomepageText"/></Hyperlink>
                  </TextBlock>
                </Grid>

                <TextBlock Text="Version to install" Foreground="{StaticResource Muted}" Margin="0,16,0,6"/>
                <ComboBox x:Name="VersionCombo" Height="32" VerticalContentAlignment="Center"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="Install"/>
                  <Button x:Name="UninstallButton" Style="{StaticResource DangerButton}" Content="Uninstall" Margin="8,0,0,0"/>
                </StackPanel>
                <CheckBox x:Name="ForceCheck" Content="Reinstall even if this version is already installed" Margin="0,12,0,0" Foreground="{StaticResource Muted}"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- Add applications view -->
      <Grid x:Name="AddView" Grid.Row="2" Margin="28,0,28,0" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="AddKeyBanner" Grid.ColumnSpan="2" Margin="0,0,0,12" Padding="14,10" CornerRadius="8"
                Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" Visibility="Collapsed">
          <DockPanel>
            <Button x:Name="AddOpenSettings" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,4" Content="Open Settings"/>
            <TextBlock VerticalAlignment="Center" Foreground="#1E3A8A" TextWrapping="Wrap"
                       Text="Adding applications requires the server API key. Enter it under Settings."/>
          </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
          <RadioButton x:Name="AddModeWinget" Style="{StaticResource TabButton}" GroupName="AddMode" IsChecked="True" Content="From winget"/>
          <RadioButton x:Name="AddModeUpload" Style="{StaticResource TabButton}" GroupName="AddMode" Content="Upload installer"/>
          <RadioButton x:Name="AddModeManifest" Style="{StaticResource TabButton}" GroupName="AddMode" Content="Manifest (any source)"/>
        </StackPanel>

        <!-- From winget -->
        <Grid x:Name="WingetPanel" Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                <Button x:Name="WingetSearchButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Search winget"/>
                  </StackPanel>
                </Button>
                <TextBox x:Name="WingetQuery" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
              </DockPanel>
              <TextBlock x:Name="WingetHint" DockPanel.Dock="Top" Margin="16,0,16,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                         Text="Search the winget catalog by name or id (for example: notepad, Mozilla.Firefox) and select a result to preview it."/>
              <ListView x:Name="WingetResults" BorderThickness="0" Margin="8,0,8,8">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="Name" Width="230" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Winget id" Width="260" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="Version" Width="120" DisplayMemberBinding="{Binding Version}"/>
                    <GridViewColumn Header="In repository" Width="100" DisplayMemberBinding="{Binding InRepositoryText}"/>
                  </GridView>
                </ListView.View>
              </ListView>
            </DockPanel>
          </Border>

          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
            <Grid>
              <TextBlock x:Name="AddNoSelection" Text="Select a search result to preview it" Foreground="{StaticResource Muted}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
              <ScrollViewer x:Name="AddPane" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="22">
                  <TextBlock x:Name="AddName" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="AddPublisher" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="AddDescription" TextWrapping="Wrap" Foreground="#374151" Margin="0,12,0,0"/>
                  <Border x:Name="AddMsiBadge" CornerRadius="6" Padding="10,6" Margin="0,14,0,0" Background="#F3F4F6">
                    <TextBlock x:Name="AddMsiText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  </Border>
                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Winget id"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="AddId" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Latest version"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" x:Name="AddVersion" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Installer"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" x:Name="AddInstaller"/>
                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="All installers"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" x:Name="AddAllInstallers"/>
                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="File"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}" x:Name="AddFile"/>
                  </Grid>
                  <TextBlock Text="Category" Foreground="{StaticResource Muted}" Margin="0,14,0,6"/>
                  <ComboBox x:Name="AddCategory" IsEditable="True" Height="32" VerticalContentAlignment="Center"/>
                  <CheckBox x:Name="AddCheckNow" Content="Download it to the repository now" IsChecked="True" Margin="0,14,0,0"/>
                  <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Content="Add to repository" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                  <TextBlock x:Name="AddResult" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- Upload an installer (manual applications) -->
        <Grid x:Name="UploadPanel" Grid.Row="2" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="22">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="UpNewApp" GroupName="UpTarget" IsChecked="True" Content="New application" Margin="0,0,20,0"/>
                  <RadioButton x:Name="UpExistingApp" GroupName="UpTarget" Content="New version of an existing application"/>
                </StackPanel>

                <TextBlock Text="Installer file" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <DockPanel>
                  <Button x:Name="UpBrowse" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Browse..." Margin="8,0,0,0"/>
                  <TextBox x:Name="UpFile" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
                </DockPanel>
                <TextBlock Text="Version (leave empty for MSI files - it is read from the file)" Foreground="{StaticResource Muted}" Margin="0,12,0,6"/>
                <TextBox x:Name="UpVersion" Height="32" Width="220" HorizontalAlignment="Left" VerticalContentAlignment="Center" Padding="6,0"/>

                <StackPanel x:Name="UpExistingFields" Visibility="Collapsed" Margin="0,12,0,0">
                  <TextBlock Text="Application" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                  <ComboBox x:Name="UpExistingId" Height="32" IsEditable="True" VerticalContentAlignment="Center"/>
                  <CheckBox x:Name="UpReplace" Content="Replace the version if it is already in the repository" Margin="0,10,0,0"/>
                </StackPanel>

                <Grid x:Name="UpNewFields" Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Text="Application id *"/>
                  <TextBox Grid.Row="0" Grid.Column="1" x:Name="UpId" Height="30" Margin="0,4" VerticalContentAlignment="Center" ToolTip="e.g. Contoso.Timesheets (letters, digits, . _ + -)"/>
                  <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Text="Name *"/>
                  <TextBox Grid.Row="1" Grid.Column="1" x:Name="UpName" Height="30" Margin="0,4" VerticalContentAlignment="Center"/>
                  <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Text="Publisher"/>
                  <TextBox Grid.Row="2" Grid.Column="1" x:Name="UpPublisher" Height="30" Margin="0,4" VerticalContentAlignment="Center"/>
                  <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Text="Category"/>
                  <ComboBox Grid.Row="3" Grid.Column="1" x:Name="UpCategory" Height="30" Margin="0,4" IsEditable="True" VerticalContentAlignment="Center"/>
                  <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Text="Description"/>
                  <TextBox Grid.Row="4" Grid.Column="1" x:Name="UpDescription" Height="30" Margin="0,4" VerticalContentAlignment="Center"/>
                  <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Text="Installer type"/>
                  <ComboBox Grid.Row="5" Grid.Column="1" x:Name="UpType" Height="30" Margin="0,4" Width="200" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                  <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Text="Silent install arguments"/>
                  <TextBox Grid.Row="6" Grid.Column="1" x:Name="UpArgs" Height="30" Margin="0,4" VerticalContentAlignment="Center" ToolTip="Leave empty to use the defaults for the installer type. Required for 'exe'."/>
                  <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Text="Uninstall command"/>
                  <TextBox Grid.Row="7" Grid.Column="1" x:Name="UpUninstall" Height="30" Margin="0,4" VerticalContentAlignment="Center" ToolTip="Optional. MSI products are uninstalled by product code automatically."/>
                  <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Text="Detection (name regex)"/>
                  <TextBox Grid.Row="8" Grid.Column="1" x:Name="UpDetect" Height="30" Margin="0,4" VerticalContentAlignment="Center" ToolTip="Regular expression for the Programs and Features name. Default: ^Name"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                  <Button x:Name="UpButton" Style="{StaticResource PrimaryButton}" Content="Upload to repository"/>
                </StackPanel>
                <TextBlock x:Name="UpResult" TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
            <StackPanel Margin="22">
              <TextBlock Text="Manual applications" FontWeight="SemiBold" FontSize="15"/>
              <TextBlock TextWrapping="Wrap" Foreground="#374151" Margin="0,8,0,0" LineHeight="19"
                         Text="Use this for software that cannot be downloaded automatically: in-house applications, licensed software, or anything that is not in winget."/>
              <TextBlock TextWrapping="Wrap" Foreground="#374151" Margin="0,10,0,0" LineHeight="19"
                         Text="The file is processed like any download: silent install and uninstall commands, an Intune package with its deployment sheet and detection script, and the version history (the newest versions are kept)."/>
              <TextBlock TextWrapping="Wrap" Foreground="#374151" Margin="0,10,0,0" LineHeight="19"
                         Text="MSI files supply their own version and product code. For other files enter the version, and choose the installer type so the right silent switches are used."/>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0" LineHeight="19"
                         Text="Manual applications are never checked for updates; upload each new version here, with Publish-DepotInstaller, or with: depot app upload &lt;id&gt; &lt;file&gt;"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Manifest editor (any source type) -->
        <Grid x:Name="ManifestPanel" Grid.Row="2" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <DockPanel Margin="16">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Template" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
                <ComboBox x:Name="ManTemplate" Width="160" Height="30" VerticalContentAlignment="Center"/>
                <Button x:Name="ManLoadTemplate" Style="{StaticResource SecondaryButton}" Content="Load" Margin="8,0,0,0" Padding="12,4"/>
                <TextBlock Text="  See docs/manifest-reference.md for every option" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              </DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="ManTest" Style="{StaticResource SecondaryButton}" Content="Test"/>
                <Button x:Name="ManAdd" Style="{StaticResource PrimaryButton}" Content="Add to repository" Margin="8,0,0,0"/>
                <CheckBox x:Name="ManCheckNow" Content="Download it now" IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <CheckBox x:Name="ManReplace" Content="Replace if it exists" VerticalAlignment="Center" Margin="14,0,0,0"/>
              </StackPanel>
              <TextBox x:Name="ManYaml" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Padding="6"/>
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="22">
                <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="15"/>
                <Border x:Name="ManBadge" CornerRadius="6" Padding="10,6" Margin="0,12,0,0" Background="#F3F4F6">
                  <TextBlock x:Name="ManNote" TextWrapping="Wrap" FontWeight="SemiBold" Text="Write or load a manifest, then click Test to see which installer the server would download."/>
                </Border>
                <TextBlock x:Name="ManDetails" TextWrapping="Wrap" Margin="0,12,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                <TextBlock x:Name="ManResult" TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>

      <!-- Activity view -->
      <Grid x:Name="ActivityView" Grid.Row="2" Margin="28,0,28,0" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="200"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Server activity" FontWeight="SemiBold" FontSize="15" Margin="16,14,16,8"/>
            <ListView x:Name="EventList" BorderThickness="0" Margin="8,0,8,8">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Time" Width="150" DisplayMemberBinding="{Binding TimeText}"/>
                  <GridViewColumn Header="Level" Width="60" DisplayMemberBinding="{Binding Level}"/>
                  <GridViewColumn Header="Event" Width="90" DisplayMemberBinding="{Binding Event}"/>
                  <GridViewColumn Header="Application" Width="190" DisplayMemberBinding="{Binding Id}"/>
                  <GridViewColumn Header="Message" Width="520" DisplayMemberBinding="{Binding Message}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="This session" FontWeight="SemiBold" FontSize="15" Margin="16,12,16,6"/>
            <TextBox x:Name="LocalLog" IsReadOnly="True" BorderThickness="0" Margin="12,0,12,12" FontFamily="Cascadia Mono, Consolas"
                     FontSize="12" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Background="Transparent"/>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Settings view -->
      <ScrollViewer x:Name="SettingsView" Grid.Row="2" Margin="28,0,28,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Padding="24" MaxWidth="720" HorizontalAlignment="Left" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Repository server" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="URL of the AppDepot server, e.g. http://appdepot.corp.example.com:8080" Foreground="{StaticResource Muted}" Margin="0,4,0,8"/>
            <TextBox x:Name="SettingServer" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>

            <TextBlock Text="Transfer method" FontWeight="SemiBold" FontSize="15" Margin="0,20,0,0"/>
            <TextBlock Text="How installers are copied from the repository to this computer." Foreground="{StaticResource Muted}" Margin="0,4,0,8"/>
            <ComboBox x:Name="SettingTransfer" Height="32" Width="360" HorizontalAlignment="Left" VerticalContentAlignment="Center">
              <ComboBoxItem Tag="Auto" Content="Automatic (network share, then HTTP)"/>
              <ComboBoxItem Tag="Unc" Content="Network share (SMB) only"/>
              <ComboBoxItem Tag="Http" Content="HTTP download only"/>
            </ComboBox>

            <CheckBox x:Name="SettingKeep" Content="Keep installers in the local cache after installation" Margin="0,20,0,0"/>

            <TextBlock Text="Server API key" FontWeight="SemiBold" FontSize="15" Margin="0,20,0,0"/>
            <TextBlock Text="Only needed to add or remove applications and to start server checks. Leave empty to keep the saved key."
                       Foreground="{StaticResource Muted}" Margin="0,4,0,8" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal">
              <PasswordBox x:Name="SettingApiKey" Height="32" Width="360" VerticalContentAlignment="Center" Padding="6,0"/>
              <TextBlock x:Name="SettingApiKeyState" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock Text="Client folders" FontWeight="SemiBold" FontSize="15" Margin="0,20,0,4"/>
            <TextBlock x:Name="SettingPaths" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
              <Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButton}" Content="Save"/>
              <Button x:Name="TestConnectionButton" Style="{StaticResource SecondaryButton}" Content="Test connection" Margin="8,0,0,0"/>
              <Button x:Name="OpenLogButton" Style="{StaticResource SecondaryButton}" Content="Open log folder" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="SettingsResult" Margin="0,14,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- Status bar -->
      <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,8" Margin="0,12,0,0">
        <DockPanel>
          <ProgressBar x:Name="Busy" DockPanel.Dock="Right" Width="160" Height="6" IsIndeterminate="False" Visibility="Hidden" Foreground="{StaticResource Accent}"/>
          <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
